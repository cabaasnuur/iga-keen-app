<!DOCTYPE html>
<html lang="so">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IGA KEEN | Admin</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f4f4;
      color: #111;
    }
    header {
      background: #000;
      color: #fff;
      padding: 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    header h1 { margin: 0; font-size: 21px; }
    button {
      border: 0;
      border-radius: 8px;
      padding: 11px 14px;
      font-weight: bold;
      cursor: pointer;
    }
    .black { background: #000; color: #fff; }
    .light { background: #eee; color: #111; }
    main { max-width: 1000px; margin: auto; padding: 16px; }
    .panel {
      background: #fff;
      border-radius: 14px;
      padding: 20px;
      margin-bottom: 16px;
      box-shadow: 0 2px 10px #0000000b;
    }
    input, select {
      width: 100%;
      padding: 13px;
      margin: 7px 0 13px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
      background: #fff;
    }
    label { font-size: 14px; font-weight: bold; }
    .hidden { display: none !important; }
    .muted { color: #666; font-size: 14px; }
    .orders { display: grid; gap: 14px; }
    .order {
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 12px;
      padding: 16px;
      overflow-wrap: anywhere;
    }
    .order h3 { margin: 0 0 10px; }
    .row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }
    .status { font-weight: bold; }
    .message { margin: 12px 0; font-size: 14px; }
    .error { color: #b00020; }
    .success { color: #087443; }
    .order select { margin-bottom: 8px; }
    @media (min-width: 650px) {
      .orders { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>
</head>
<body>
  <header>
    <h1>IGA KEEN <span class="muted" style="color:#ccc">ADMIN</span></h1>
    <button id="logoutBtn" class="light hidden">Ka bax</button>
  </header>

  <main>
    <section id="loginPanel" class="panel">
      <h2>Admin Login</h2>
      <p class="muted">Geli email-ka iyo password-ka akoonkaaga Supabase Admin.</p>
      <form id="loginForm">
        <label for="email">Email</label>
        <input id="email" type="email" autocomplete="username" required>
        <label for="password">Password</label>
        <input id="password" type="password" autocomplete="current-password" required>
        <button class="black" type="submit" style="width:100%">Soo gal</button>
      </form>
      <p id="loginMessage" class="message" role="status"></p>
    </section>

    <section id="dashboard" class="hidden">
      <div class="panel">
        <div class="row">
          <div>
            <h2 style="margin:0 0 6px">Dalabaadka</h2>
            <p class="muted" style="margin:0">Dalabaadka IGA KEEN ee ku jira Supabase.</p>
          </div>
          <button id="refreshBtn" class="black">Cusboonaysii</button>
        </div>
        <p id="orderCount" class="muted">Dalabaad: 0</p>
        <p id="dashboardMessage" class="message" role="status"></p>
      </div>
      <div id="ordersList" class="orders"></div>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const SUPABASE_URL = "https://zywwypqddnvslgqztnep.supabase.co";
    const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_fDRyejheqSBrLQcBe8KpQw_L76yFtp8";

    const ADMIN_UID = "85282aac-7813-442f-a51b-6d43e3eccf1e";

    const db = window.supabase.createClient(
      SUPABASE_URL,
      SUPABASE_PUBLISHABLE_KEY,
      {
        auth: {
          persistSession: true,
          autoRefreshToken: true,
          detectSessionInUrl: true
        }
      }
    );

    const $ = id => document.getElementById(id);

    function showMessage(id, text, isError = false) {
      const el = $(id);
      el.textContent = text;
      el.className = "message " + (isError ? "error" : "success");
    }

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, char => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[char]);
    }

    function showLogin() {
      $("loginPanel").classList.remove("hidden");
      $("dashboard").classList.add("hidden");
      $("logoutBtn").classList.add("hidden");
    }

    function showDashboard() {
      $("loginPanel").classList.add("hidden");
      $("dashboard").classList.remove("hidden");
      $("logoutBtn").classList.remove("hidden");
    }

    async function verifyAdmin() {
      const { data, error } = await db.auth.getSession();

      if (error || !data.session) {
        showLogin();
        return false;
      }

      if (data.session.user.id !== ADMIN_UID) {
        await db.auth.signOut();
        showLogin();
        showMessage("loginMessage", "Akoonkan looma oggola Admin Dashboard.", true);
        return false;
      }

      showDashboard();
      return true;
    }

    $("loginForm").addEventListener("submit", async event => {
      event.preventDefault();
      showMessage("loginMessage", "Waa la hubinayaa...");

      const email = $("email").value.trim();
      const password = $("password").value;

      const { error } = await db.auth.signInWithPassword({ email, password });

      $("password").value = "";

      if (error) {
        showMessage("loginMessage", "Login-ku wuu fashilmay. Hubi email-ka iyo password-ka.", true);
        return;
      }

      const ok = await verifyAdmin();
      if (ok) await loadOrders();
    });

    $("logoutBtn").addEventListener("click", async () => {
      await db.auth.signOut();
      showLogin();
      showMessage("loginMessage", "Waad ka baxday akoonka.");
    });

    $("refreshBtn").addEventListener("click", loadOrders);

    function displayValue(value) {
      return value === null || value === undefined || value === ""
        ? "Lama sheegin"
        : escapeHTML(value);
    }

    function makeOrderCard(order) {
      const card = document.createElement("article");
      card.className = "order";

      const statuses = ["pending", "accepted", "in_progress", "completed", "cancelled"];
      const statusNames = {
        pending: "Sugaya",
        accepted: "La aqbalay",
        in_progress: "Socda",
        completed: "La dhammeeyey",
        cancelled: "La joojiyey"
      };

      const currentStatus = statuses.includes(order.status) ? order.status : "pending";

      card.innerHTML = `
        <div class="row">
          <h3>Dalab #${displayValue(order.order_number || order.id)}</h3>
          <span class="status">${displayValue(statusNames[currentStatus] || currentStatus)}</span>
        </div>
        <p><b>Adeeg:</b> ${displayValue(order.service_type)}</p>
        <p><b>Macmiil:</b> ${displayValue(order.customer_name)}</p>
        <p><b>Telefoon:</b> ${displayValue(order.customer_phone)}</p>
        <p><b>Laga qaadayo:</b> ${displayValue(order.pickup_address)}</p>
        <p><b>Loo socdo:</b> ${displayValue(order.destination_address)}</p>
        <p><b>Faahfaahin:</b> ${displayValue(order.notes)}</p>
        <p><b>Taariikh:</b> ${displayValue(order.created_at)}</p>
        <label for="status-${escapeHTML(order.id)}">Xaaladda dalabka</label>
        <select id="status-${escapeHTML(order.id)}">
          ${statuses.map(s => `
            <option value="${s}" ${s === currentStatus ? "selected" : ""}>
              ${statusNames[s]}
            </option>
          `).join("")}
        </select>
        <button class="black save-status">Kaydi xaaladda</button>
        <p class="message status-message" role="status"></p>
      `;

      card.querySelector(".save-status").addEventListener("click", async () => {
        const button = card.querySelector(".save-status");
        const message = card.querySelector(".status-message");
        const newStatus = card.querySelector("select").value;

        button.disabled = true;
        message.textContent = "Waa la kaydinayaa...";

        const { error } = await db
          .from("orders")
          .update({ status: newStatus })
          .eq("id", order.id);

        button.disabled = false;

        if (error) {
          message.textContent = "Kaydintu way fashilantay: " + error.message;
          message.className = "message error";
          return;
        }

        message.textContent = "Xaaladda waa la kaydiyey.";
        message.className = "message success";
        card.querySelector(".status").textContent = statusNames[newStatus];
        order.status = newStatus;
      });

      return card;
    }

    async function loadOrders() {
      if (!(await verifyAdmin())) return;

      showMessage("dashboardMessage", "Dalabaadka waa la soo rarayaa...");
      $("ordersList").replaceChildren();

      const { data, error } = await db
        .from("orders")
        .select("*")
        .order("order_number", { ascending: false });

      if (error) {
        showMessage(
          "dashboardMessage",
          "Dalabaadka lama soo qaadi karin. Hubi RLS policies-ka. " + error.message,
          true
        );
        return;
      }

      $("orderCount").textContent = "Dalabaad: " + data.length;

      if (!data.length) {
        showMessage("dashboardMessage", "Weli dalab ma jiro.");
        return;
      }

      showMessage("dashboardMessage", "Dalabaadka waa la soo raray.");
      const fragment = document.createDocumentFragment();
      data.forEach(order => fragment.appendChild(makeOrderCard(order)));
      $("ordersList").appendChild(fragment);
    }

    db.auth.onAuthStateChange((_event, session) => {
      if (!session) showLogin();
    });

    (async () => {
      if (await verifyAdmin()) await loadOrders();
    })();
  </script>
</body>
</html>